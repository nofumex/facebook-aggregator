POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://aggregator:change-me@localhost:5432/facebook_aggregator?sslmode=disable
DB_MAX_CONNS=5
DB_MIN_CONNS=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=123456789
# Generate: openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=
HTTP_ADDR=:8080

# Independent semantic extraction. Model IDs are checked against /v1/models
# on first extraction; unavailable IDs are skipped.
LLM_EXTRACTION_ENABLED=false
LLM_EXTRACTION_BASE_URL=
LLM_EXTRACTION_API_KEY=
LLM_EXTRACTION_TIMEOUT=25s
LLM_EXTRACTION_CONCURRENCY=2
LLM_EXTRACTION_RETRY_BASE=500ms
LLM_EXTRACTION_MAX_ATTEMPTS=4
LLM_EXTRACTION_SCHEMA_VERSION=rental-v1
LLM_EXTRACTION_MODELS=ministral-3-8b,gpt-oss-20b,gemma-sea-lion-v4-27b,gemini-3.5-flash-lite
# Optional single FreeLLMAPI auto:<name> route used once after operational failures.
LLM_EXTRACTION_AUTO_MODEL=
LLM_EXTRACTION_MODEL_TIMEOUTS=gemma-sea-lion-v4-27b=60s,gemini-3.5-flash-lite=60s
BACKFILL_CONCURRENCY=2
EXTRACTION_RETRY_INTERVAL=5m
EXTRACTION_RETRY_BATCH=20
RERANK_INTERVAL=15m
RERANK_BATCH=100
DEFAULT_POLL_INTERVAL=5m
SYNC_CONCURRENCY=3

# Facebook browser-session cookies. Never commit the real values.
FACEBOOK_C_USER=
FACEBOOK_XS=
FACEBOOK_SB=
FACEBOOK_DATR=
FACEBOOK_PS_L=1
FACEBOOK_PS_N=1
FACEBOOK_FR=
FB_MIN_REQUEST_GAP=1200ms
FB_MAX_RETRIES=4
FB_DISABLE_HTTP2=false
# Optional comma-separated overrides after Facebook rotates query IDs:
# FB_DOC_IDS=CometGroupDiscussionRootSuccessQuery=123,GroupsCometFeedRegularStoriesPaginationQuery=456
